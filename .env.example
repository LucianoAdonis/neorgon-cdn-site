# Cloudflare R2 Configuration
# Copy this file to .env and fill in your values

# These four are what scripts/upload-assets.js reads. It talks to R2 over the
# S3-compatible API, so it needs the S3 key pair — not a Cloudflare API token.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=neorgon-cdn-prod

# Only wrangler needs this, for `npm run deploy`; `wrangler login` is the alternative.
# The uploader ignores it.
CLOUDFLARE_API_TOKEN=your_api_token_here
